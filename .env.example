# cfd-harness-windows-starccm — environment template.
# Copy to .env (which is gitignored) and fill in. NEVER commit real secrets.

# HMAC key for signing the V&V audit manifest (audit_package, DEC-010).
# REQUIRED for any audit you intend to trust. Generate a 256-bit key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it, `python -m cfd_harness.cli.run` signs with the explicitly
# UNTRUSTED dev key and stamps the audit key_source=dev-unsigned / trusted=false.
# In CI, inject this from a secrets manager — do not hardcode it.
CFD_HARNESS_SIGN_KEY=
